generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  ean         String?  @unique
  name        String
  brand       String?
  category    String?
  subcategory String?
  subsubcategory String?
  unitCount   Int?     // normalized quantity (e.g. 64 un, 1500 ml, 500 g)
  unitType    String?  // normalized unit: un | ml | g
  imageUrl    String?
  source      String   @default("continente")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prices      Price[]

  @@index([ean])
  @@index([name])
}

model Price {
  id          String   @id @default(uuid())
  productId   String
  retailer    String   @default("continente") // source per price row
  priceCents  Int
  currency    String   @default("EUR")
  pvpCents    Int?
  pricePerKgCents Int?
  priceUnit   String?  // 'kg' | 'l' | 'un'
  capturedAt  DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([capturedAt])
  @@index([productId, retailer, capturedAt])
}

model ScrapeJob {
  id          String   @id @default(uuid())
  category    String   // category name/path
  label       String?  // human-readable label for display
  limit       Int      @default(0) // max products for this job (0 = all)
  status      String   @default("pending") // pending, running, completed, failed, canceled
  total       Int      @default(0)
  scraped     Int      @default(0)
  errors      Int      @default(0)
  cursorStart Int      @default(0) // listing cursor (start=) for resume
  startedAt   DateTime @default(now())
  completedAt DateTime?
  delayMs     Int      @default(2000)
}

model RetailerScrapeJob {
  id            String   @id @default(uuid())
  retailer      String   // e.g. 'auchan'
  status        String   @default("pending") // pending|running|completed|failed|canceled
  dryRun        Boolean  @default(false)
  cursor        Int      @default(0) // URL index cursor
  totalUrls     Int      @default(0)
  processed     Int      @default(0)
  matched       Int      @default(0)
  unmatched     Int      @default(0)
  insertedPrices Int     @default(0)
  unchanged     Int      @default(0)
  errors        Int      @default(0)
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  unmatchedRows RetailerUnmatched[]

  @@index([retailer, status, startedAt])
}

model RetailerUnmatched {
  id              String   @id @default(uuid())
  retailer        String
  url             String
  ean             String?
  internalId      String?  // Source-local identity (e.g., Pingo Doce internal product ID)
  name            String?
  reason          String
  matchConfidence Float?   // Confidence score if fallback was attempted
  matchTier       String?  // Tier used in matching attempt
  matchReason     String?  // Detailed reason from matcher
  jobId           String
  createdAt       DateTime @default(now())

  job RetailerScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([retailer, createdAt])
  @@index([jobId])
  @@index([ean])
}

model RetailerCategoryBlock {
  id          String   @id @default(uuid())
  retailer    String
  category    String
  subcategory String?
  blocked     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([retailer, category, subcategory])
  @@index([retailer, blocked])
}

model TempProduct {
  id              String   @id @default(uuid())
  retailer        String
  sourceUrl       String   @unique
  ean             String?
  internalId      String?  // Source-local identity (e.g., Pingo Doce internal product ID)
  name            String?
  brand           String?
  category        String?
  subcategory     String?
  unitCount       Int?
  unitType        String?
  packCount       Int?
  packUnitSize    Float?
  packUnitType    String?
  imageUrl        String?
  status          String   @default("pending") // pending|approved|rejected|imported
  matchConfidence Float?   // Confidence score from fallback matching (0-1)
  matchTier       String?  // Tier of match: tier1, tier2, ean
  matchReason     String?  // Reason text: exact_match, similarity_review, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices      TempPrice[]

  @@index([retailer, status, createdAt])
  @@index([ean])
}

model TempPrice {
  id              String   @id @default(uuid())
  tempProductId   String
  priceCents      Int
  pvpCents        Int?
  pricePerKgCents Int?
  priceUnit       String?
  capturedAt      DateTime @default(now())

  tempProduct TempProduct @relation(fields: [tempProductId], references: [id], onDelete: Cascade)

  @@index([tempProductId, capturedAt])
}

model Settings {
  id        String   @id @default("default")
  delayMs   Int      @default(2000)
  updatedAt DateTime @updatedAt
}

model Category {
  id            String   @id @default(uuid())
  name          String   // URL-friendly name: "arroz-massa-e-farinha"
  label         String   // Display name: "Arroz, Massa e Farinha"
  level         Int      // 1 = main, 2 = sub, 3 = subsub
  parentId      String?
  parent        Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryHierarchy")
  urlPath       String   // Full URL path: "/mercearia/arroz-massa-e-farinha/"
  productCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, parentId]) // Unique sibling names
  @@index([level])
  @@index([parentId])
}
